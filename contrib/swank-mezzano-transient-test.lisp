;;; This code is in the public domain.

(defpackage #:swank-mezzano-transient-test
  (:use #:cl)
  (:local-nicknames (#:adapter #:swank/mezzano-debugger))
  (:export #:run))
(in-package #:swank-mezzano-transient-test)

(defun await (function)
  (let ((deadline (+ (get-internal-real-time) (* 10 internal-time-units-per-second))))
    (loop for result = (funcall function)
          when result return result
          do (assert (< (get-internal-real-time) deadline))
             (sleep 0.01))))

(defun name ()
  (string-downcase (format nil "~64,'0X" (random (expt 2 256)))))

(defun value (reply)
  (assert (eq (first reply) :ok))
  (second reply))

(defun detached (name)
  (let ((session (gethash name adapter::*sessions*)))
    (assert (null (adapter::session-connection session)))
    (assert (null (adapter::session-controller session)))
    session))

(defun run ()
  (let* ((first (list :first-test-connection))
         (second (list :second-test-connection))
         (swank::*connections* (list first second))
         (swank::*emacs-connection* first)
         (adapter::*sessions* (make-hash-table :test #'equal))
         (adapter::*lock* (mezzano.supervisor:make-mutex 'transient-test))
         (adapter::*boot* (mezzano.supervisor:current-boot-id))
         (name (name))
         (other-name (name))
         (job nil)
         (stop nil))
    (unwind-protect
         (progn
           (assert (equal (value (adapter:transient-request name :open-session)) name))
           (detached name)
           (assert (equal (value (adapter:transient-request name :resume-session)) name))
           (detached name)
           (let ((swank::*emacs-connection* second))
             (assert (equal (value (adapter:resume-session name)) name)))
           (assert (equal (adapter:transient-request name :jobs) '(:error :session-attached)))
           (let ((session (gethash name adapter::*sessions*)))
             (assert (eq (adapter::session-connection session) second))
             (let ((swank::*emacs-connection* second))
               (assert (equal (adapter:transient-request other-name :open-session)
                              '(:error :connection-attached)))
               (assert (eq (adapter::session-connection session) second))))
           (adapter::close-session-connection second)
           (detached name)
           (assert (handler-case (progn (adapter:transient-request name :unknown-test-operation) nil)
                     (error () t)))
           (detached name)
           (assert (equal (adapter:transient-request name :attach nil)
                          '(:error :transient-attachment)))
           (detached name)
           (let* ((token (value (adapter:transient-request
                                name :start-evaluation (name)
                                "(progn (cerror \"Continue\" \"Transient request fixture\") (values 42))")))
                  (session (detached name)))
             (setf job (adapter::decode-handle session :job token))
             (setf stop (await (lambda () (first (getf (mezzano.debug:evaluation-job-information job) :stops)))))
             (let* ((info (value (adapter:transient-request name :job-information token)))
                    (stop-token (first (getf info :stops)))
                    (handles (hash-table-count (adapter::session-handles session))))
               (assert (equal (adapter:transient-request name :submit stop-token 0 :select-frame 1000000)
                              '(:error :invalid-frame)))
               (detached name)
               (assert (zerop (getf (mezzano.debug:debugger-stop-information stop) :next-command-id)))
               (assert (equal (adapter:transient-request name :submit stop-token 0 :locals nil)
                              '(:error :invalid-handle)))
               (detached name)
               (assert (= (value (adapter:transient-request name :submit stop-token 0 :restarts)) 0))
               (detached name)
               (await (lambda () (eq (getf (value (adapter:transient-request name :result stop-token 0)) :state)
                                     :returned)))
               (assert (= (value (adapter:transient-request name :submit stop-token 0 :restarts)) 0))
               (assert (= handles (hash-table-count (adapter::session-handles session))))
               (let ((swank::*emacs-connection* second))
                 (value (adapter:open-session other-name))
                 (let* ((other (gethash other-name adapter::*sessions*))
                        (other-stop (adapter::encode-stop other stop))
                        (lease (value (adapter:request other-name :attach other-stop))))
                   (assert (eq (adapter::session-connection other) second))
                   (let ((swank::*emacs-connection* first))
                     (assert (equal (adapter:transient-request name :submit stop-token 1 :proceed)
                                    '(:error :already-controlled)))
                     (detached name))
                   (assert (equal (value (adapter:request other-name :submit lease 1 :restarts)) 1)))
                 (value (adapter:request other-name :release-session)))
               (await (lambda () (eq (getf (value (adapter:transient-request name :result stop-token 1)) :state)
                                     :returned)))
               (assert (= (value (adapter:transient-request name :submit stop-token 2 :proceed)) 2))
               (detached name)
               (await (lambda () (eq (getf (mezzano.debug:evaluation-job-information job) :state) :returned)))
               (assert (equal (getf (mezzano.debug:evaluation-job-information job) :values) '("42")))
               (value (adapter:transient-request name :release-stop stop-token))
               (setf stop nil)
               (value (adapter:transient-request name :release-job token))
               (setf job nil)))
           (let* ((token (value (adapter:transient-request
                                name :start-evaluation (name)
                                "(cerror \"Continue\" \"Transient command input\") 42")))
                  (session (detached name)))
             (setf job (adapter::decode-handle session :job token)
                   stop (await (lambda () (first (getf (mezzano.debug:evaluation-job-information job) :stops)))))
             (let ((stop-token (first (getf (value (adapter:transient-request
                                                   name :job-information token)) :stops))))
               (value (adapter:transient-request
                       name :submit stop-token 0 :evaluate
                       "(progn (write-string \"Input: \" *query-io*) (read-line))"))
               (await (lambda () (getf (value (adapter:transient-request name :result stop-token 0))
                                       :input-waiting-p)))
               (assert (equal (value (adapter:transient-request name :command-output stop-token 0 0))
                              '(:start 0 :text "Input: " :end 7)))
               (assert (= (value (adapter:transient-request name :command-input stop-token 0 0 "α")) 1))
               (detached name)
               (let ((reader-name (name)))
                 (let ((swank::*emacs-connection* second))
                   (value (adapter:open-session reader-name))
                   (let* ((other (gethash reader-name adapter::*sessions*))
                          (other-stop (adapter::encode-stop other stop))
                          (lease (value (adapter:request reader-name :attach other-stop))))
                     (let ((swank::*emacs-connection* first))
                       (assert (equal (adapter:transient-request
                                       name :command-input stop-token 0 1 "bad")
                                      '(:error :already-controlled)))
                       (detached name))
                     (assert (= (value (adapter:request reader-name :command-input
                                                       lease 0 1 (format nil "β~%"))) 3)))
                   (value (adapter:request reader-name :release-session))))
               (await (lambda () (eq (getf (value (adapter:transient-request name :result stop-token 0))
                                           :state) :returned)))
               (assert (= (value (adapter:transient-request name :command-input stop-token 0 0 "α")) 1))
               (assert (equal (adapter:transient-request name :command-input stop-token 0 0 "x")
                              '(:error :input-conflict)))
               (assert (equal (adapter:transient-request name :command-output stop-token 0 0 100)
                              '(:error :invalid-output-range)))
               (detached name)
               (assert (equal (getf (value (adapter:transient-request name :result stop-token 0)) :result)
                              '("\"αβ\"" "NIL")))
               (value (adapter:transient-request name :submit stop-token 1 :proceed))
               (await (lambda () (eq (getf (mezzano.debug:evaluation-job-information job) :state) :returned)))
               (value (adapter:transient-request name :release-stop stop-token))
               (setf stop nil)
               (value (adapter:transient-request name :release-job token))
               (setf job nil)))
           (value (adapter:transient-request name :release-session))
           (detached name)
           (assert (equal (adapter:transient-request name :resume-session) '(:error :expired-session))))
      (adapter::close-session-connection first)
      (adapter::close-session-connection second)
      (when stop
        (let* ((controller (mezzano.debug:make-debugger-controller))
               (lease (mezzano.debug:attach-debugger-stop stop controller)))
          (unwind-protect
               (progn
                 (let ((info (mezzano.debug:debugger-stop-information stop)))
                   (when (eq (getf info :state) :stopped)
                     (mezzano.debug:submit-debugger-command lease (getf info :next-command-id) :abort)
                     (await (lambda () (not (eq (getf (mezzano.debug:evaluation-job-information job) :state)
                                                 :running))))))
                 (mezzano.debug:release-debugger-stop lease))
            (mezzano.debug:close-debugger-controller controller))))
      (when job (mezzano.debug:release-evaluation-job job))))
  (format t "PASS persistent and transient ownership, rejection/error cleanup, replay, command input/output, and retained completion.~%")
  t)
